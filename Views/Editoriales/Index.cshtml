@model List<proyectolibreria.Models.Editorial>

@{
    ViewData["Title"] = "Editoriales";
}

<div class="card shadow-sm p-4 mt-3">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-warning mb-0">🏢 Gestión de Editoriales</h2>

        <a href="/Editoriales/Crear" class="btn btn-warning fw-bold">
            ➕ Nueva Editorial
        </a>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <table class="table table-striped table-bordered">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Razón Social</th>
                <th>Teléfono</th>
                <th>País</th>
                <th style="width: 200px;">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var e in Model)
            {
                <tr>
                    <td>@e.Id</td>
                    <td>@e.Nombre</td>
                    <td>@e.Telefono</td>
                    <td>@e.Pais</td>
                    <td>
                        <a asp-action="Editar" asp-route-id="@e.Id" class="btn btn-sm btn-warning">✏️ Editar</a>
                        <form asp-action="Borrar" asp-route-id="@e.Id" method="post" class="d-inline"
                              onsubmit="return confirm('¿Borrar @e.Nombre?');">
                            <button type="submit" class="btn btn-sm btn-danger">🗑️ Borrar</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>

</div>