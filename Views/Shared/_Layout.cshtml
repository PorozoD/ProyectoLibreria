<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>📚 Sistema Librería</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
    <header>
        <nav class="navbar navbar-expand-sm navbar-dark bg-dark border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" href="/">📚 Sistema de Gestión Bibliotecaria</a>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-fluid navbar-nav flex-grow-1">
                        <li class="nav-item"><a class="nav-link text-white fw-bold mx-2" href="/Libros">📚 Libros</a></li>
                        <li class="nav-item"><a class="nav-link text-white fw-bold mx-2" href="/Clientes">👥 Clientes</a></li>
                        <li class="nav-item"><a class="nav-link text-white fw-bold mx-2" href="/Editoriales">🏢 Editoriales</a></li>
                        <li class="nav-item"><a class="nav-link text-white fw-bold mx-2" href="/Ventas">🛒 Ventas</a></li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>
    <script src="https://jsdelivr.net"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
