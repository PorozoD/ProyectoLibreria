@model List<proyectolibreria.Models.Venta>

@{
    ViewData["Title"] = "Ventas";
}

<div class="card shadow-sm p-4 mt-3">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-danger mb-0">🛒 Historial de Ventas Directas</h2>

        <a href="/Ventas/Crear" class="btn btn-danger fw-bold">
            ➕ Nueva Venta
        </a>
    </div>

    <table class="table table-striped table-bordered">
        <thead class="table-dark">
            <tr>
                <th>ID Venta</th>
                <th>Libro Vendido</th>
                <th>Cliente Comprador</th>
                <th>Cantidad</th>
                <th>Fecha y Hora</th>
                <th style="width: 200px;">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var v in Model)
            {
                <tr>
                    <td>@v.Id</td>
                    <td>@v.NombreProducto</td>
                    <td>@v.NombreCliente</td>
                    <td>@v.Cantidad u.</td>
                    <td>@v.Fecha.ToString("dd/MM/yyyy HH:mm:ss")</td>
                    <td>
                        <a asp-action="Editar" asp-route-id="@v.Id" class="btn btn-sm btn-warning">✏️ Editar</a>
                        <form asp-action="Borrar" asp-route-id="@v.Id" method="post" class="d-inline"
                              onsubmit="return confirm('¿Borrar la venta @v.Id?');">
                            <button type="submit" class="btn btn-sm btn-danger">🗑️ Borrar</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>

</div>