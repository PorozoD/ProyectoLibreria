@model List<proyectolibreria.Models.Cliente>

@{
    ViewData["Title"] = "Lectores";
}

<div class="card shadow-sm p-4 mt-3">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-success mb-0">👤 Gestión de Lectores</h2>

        <a href="/Clientes/Crear" class="btn btn-success fw-bold">
            ➕ Nuevo Lector
        </a>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <table class="table table-striped table-bordered">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Nombre</th>
                <th>Teléfono</th>
                <th style="width: 200px;">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var c in Model)
            {
                <tr>
                    <td>@c.Id</td>
                    <td>@c.Nombre</td>
                    <td>@c.Telefono</td>
                    <td>
                        <a asp-action="Editar" asp-route-id="@c.Id" class="btn btn-sm btn-warning">✏️ Editar</a>
                        <form asp-action="Borrar" asp-route-id="@c.Id" method="post" class="d-inline"
                              onsubmit="return confirm('¿Borrar a @c.Nombre?');">
                            <button type="submit" class="btn btn-sm btn-danger">🗑️ Borrar</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>

</div>