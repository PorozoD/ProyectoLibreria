@model proyectolibreria.Models.Cliente

@{
    ViewData["Title"] = "Nuevo Lector";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow-sm">
            <div class="card-body">
                <h2 class="text-success mb-4">➕ Registrar Nuevo Lector</h2>

                <form asp-controller="Clientes" asp-action="Crear" method="post">
                    <div class="mb-3">
                        <label asp-for="Nombre" class="form-label fw-bold">Nombre</label>
                        <input asp-for="Nombre" class="form-control" />
                        <span asp-validation-for="Nombre" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Telefono" class="form-label fw-bold">Teléfono</label>
                        <input asp-for="Telefono" class="form-control" />
                    </div>

                    <div class="d-flex justify-content-between">
                        <a asp-action="Index" class="btn btn-secondary">Volver</a>
                        <button type="submit" class="btn btn-success">Guardar Lector</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>